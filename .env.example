# Docker Compose ports
API_PORT=8080
AI_PORT=8000
PY_BACKEND_PORT=8001
WEB_PORT=3000

# Browser -> Go API URL. This value is baked into the Next.js client at build time.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Go API CORS policy for frozen scaffold; target CORS_ALLOWED_ORIGINS is deferred.
CORS_ORIGIN=http://localhost:3000
