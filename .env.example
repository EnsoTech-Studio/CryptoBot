# Native application ports. Local PostgreSQL is optional through the local-db
# Compose profile; Supabase/external PostgreSQL is selected by *_DATABASE_URL.
API_PORT=8080
WEB_PORT=3000
AI_PORT=8000
POSTGRES_PORT=5432
RESEARCH_PORT=8001

# PostgreSQL
POSTGRES_USER=cryptobot
POSTGRES_PASSWORD=cryptobot
POSTGRES_DB=cryptobot
RESEARCH_DATABASE_USER=research_service
RESEARCH_DATABASE_PASSWORD=research_service
API_DATABASE_USER=api_service
API_DATABASE_PASSWORD=api_service

# Native service connections. Replace these with Supabase pooler URLs to use
# external PostgreSQL instead of the optional local Docker database. Change
# these explicitly if a password contains URL-reserved characters.
MIGRATION_DATABASE_URL=postgres://cryptobot:cryptobot@127.0.0.1:5432/cryptobot?sslmode=disable
DATABASE_URL=postgres://research_service:research_service@127.0.0.1:5432/cryptobot?sslmode=disable
MARKET_DATABASE_URL=postgres://api_service:api_service@127.0.0.1:5432/cryptobot?sslmode=disable
MIGRATION_CONNECT_RETRIES=10
MIGRATION_CONNECT_RETRY_DELAY_SECONDS=2
RESEARCH_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_URL=http://127.0.0.1:8000

# Groq inference (server-side only; never expose this key to Next.js)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=10

# Browser -> Go API URL. This value is baked into the Next.js client at build time.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Explicit CORS allowlist. Add more origins with comma separation.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Internal services
INTERNAL_SERVICE_TOKEN=development-internal-token
RESEARCH_REQUEST_TIMEOUT=15s
RESEARCH_MAX_BODY_BYTES=4194304
JWT_PRIVATE_KEY_FILE=.runtime/jwt-private.pem
COOKIE_SECURE=false
MAX_REQUEST_BYTES=1048576
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_SECONDS=30
EVENT_LEASE_SECONDS=60
AI_REQUEST_TIMEOUT_SECONDS=5
SENTIMENT_MODEL=openai/gpt-oss-120b
SENTIMENT_MODEL_VERSION=groq-2026-08-31
AUTHORING_ALLOWED_ORIGINS=https://www.tradingview.com,https://medium.com,https://github.com
NEWS_COLLECTION_INTERVAL_SECONDS=900
SENTIMENT_BACKFILL_INTERVAL_SECONDS=60
