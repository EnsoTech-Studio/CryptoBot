# Docker Compose ports
API_PORT=8080
WEB_PORT=3000
AI_PORT=8000
POSTGRES_PORT=5432
PY_BACKEND_PORT=8001

# PostgreSQL
POSTGRES_USER=cryptobot
POSTGRES_PASSWORD=cryptobot
POSTGRES_DB=cryptobot

# Browser -> Go API URL. This value is baked into the Next.js client at build time.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Explicit CORS allowlist. Add more origins with comma separation.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Internal services
SENTIMENT_MODEL_VERSION=2026-08-01
