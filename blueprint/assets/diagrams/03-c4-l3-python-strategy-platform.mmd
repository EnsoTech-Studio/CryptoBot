flowchart TB
    subgraph Py["Python Research Platform - canonical domain runtime"]
        direction TB

        subgraph App["Application layer"]
            API["Research API<br/>signed commands and queries"]
            Experiment["Experiment/Search/Ranking services"]
            NewsApp["News/Sentiment orchestration"]
            AgentApp["AgentOrchestrator<br/>persisted deterministic workflow"]
        end

        subgraph Domain["Pure domain layer"]
            Strategy["StrategyRegistry + StrategyRuntime<br/>indicators and composite"]
            Backtest["Backtest Engine + Execution Simulator<br/>evaluator and provenance"]
            NewsDomain["news extraction/tagging rules<br/>quality gate and cache policy"]
            AgentDomain["agent state, attempts, artifacts,<br/>permissions and budgets"]
        end

        subgraph Ports["Ports owned by Python"]
            MarketPort["MarketDataPort"]
            ModelPort["ModelGatewayPort"]
            ArtifactPort["Artifact/Sandbox/Approval ports"]
            DataPort["Repository/Job/Outbox ports"]
        end

        subgraph Adapters["Infrastructure adapters"]
            GoMarket["Authenticated Go Market adapter<br/>closed candles, BBO and history"]
            AIAdapter["Internal AI/LLM Adapter client<br/>structured inference only"]
            SandboxAdapter["Isolated Sandbox Runner"]
            SourceAdapter["SafeFetcher + Readability"]
            Postgres["Python-owned PostgreSQL repos,<br/>jobs and transactional outbox"]
        end
    end

    API --> Experiment
    API --> NewsApp
    API --> AgentApp
    Experiment --> Strategy
    Experiment --> Backtest
    NewsApp --> NewsDomain
    AgentApp --> AgentDomain
    AgentApp --> Strategy
    AgentApp --> NewsDomain
    Strategy --> MarketPort --> GoMarket
    Backtest --> MarketPort
    NewsDomain --> ModelPort --> AIAdapter
    AgentDomain --> ModelPort
    AgentDomain --> ArtifactPort --> SandboxAdapter
    NewsDomain --> SourceAdapter
    Experiment --> DataPort --> Postgres
    NewsApp --> DataPort
    AgentApp --> DataPort

    classDef app fill:#e8f0f4,stroke:#315f7d,color:#2a251f;
    classDef domain fill:#f5eddf,stroke:#8a6127,color:#2a251f;
    classDef port fill:#faf9f6,stroke:#6b6258,color:#2a251f;
    classDef adapter fill:#e9f1eb,stroke:#426b55,color:#2a251f;
    class API,Experiment,NewsApp,AgentApp app;
    class Strategy,Backtest,NewsDomain,AgentDomain domain;
    class MarketPort,ModelPort,ArtifactPort,DataPort port;
    class GoMarket,AIAdapter,SandboxAdapter,SourceAdapter,Postgres adapter;
