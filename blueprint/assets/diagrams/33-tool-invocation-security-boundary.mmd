    classDef denied fill:#f5e8e6,stroke:#8a4545,color:#2a251f,stroke-width:1.5px;
    class Agent agent;
    class Request,Registry,Permission,Budget,Schema,Evidence,Audit control;
    class Domain,Write domain;
    class Forbidden denied;
