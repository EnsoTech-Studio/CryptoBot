classDiagram
    direction LR

    class DiscoveryController {
        +runNextTrial(runId)
        +reconcile(runId)
        +selectGenerator()
        +admitTrainThenValidation()
        +assess()
        +scheduleFinalTest()
    }
    class StrategyCandidate {
        +UUID id
        +CandidateSpec strategySpec
        +String generator
        +UUID[] parentIds
        +int generation
        +String hypothesis
        +String operation
    }
    class CandidateSpec {
        +CatalogDefinition strategy
        +RiskPolicy riskPolicy
        +canonicalHash()
    }
    class DiscoveryGenerator {
        <<interface>>
        +propose(context) StrategyCandidate
    }
    class RandomGenerator
    class MutationGenerator
    class CrossoverGenerator
    class EnsembleGenerator
    class LLMGenerator {
        +newHypothesis()
        +improveFailed()
        +combine()
    }
    class DiscoveryArchive {
        +duplicate(hash)
        +parents()
        +survivorReturns()
        +recordOutcome()
        +generatorStats()
    }
    class ValidationPolicy {
        +split 60/20/20
        +threeValidationWindows
        +score()
        +similarity()
    }
    class PartitionExperiment {
        +train|validation|test
        +validationOrdinal
        +experimentId
        +segmentRange
    }
    class Assessment {
        +trainMetrics
        +validationMetrics
        +gap
        +complexity
        +correlation
        +score
        +accepted
        +rejectionReason
    }

    DiscoveryGenerator <|.. RandomGenerator
    DiscoveryGenerator <|.. MutationGenerator
    DiscoveryGenerator <|.. CrossoverGenerator
    DiscoveryGenerator <|.. EnsembleGenerator
    DiscoveryGenerator <|.. LLMGenerator
    DiscoveryController --> DiscoveryGenerator : selects one
    DiscoveryController --> DiscoveryArchive
    DiscoveryController --> ValidationPolicy
    DiscoveryController --> PartitionExperiment
    DiscoveryArchive --> StrategyCandidate
    StrategyCandidate *-- CandidateSpec
    StrategyCandidate --> Assessment

    note for LLMGenerator "Strict JSON only; provider fail recorded.\nNo Python, queue, result-table or stop control."
    note for PartitionExperiment "Unique candidate + partition + ordinal.\nNormal completion admits one sealed final test."
