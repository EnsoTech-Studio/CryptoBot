classDiagram
    direction LR

    class CandidateGenerator {
        <<interface>>
        +id() String
        +version() String
        +validateSpace(space) ValidationResult
        +generate(ctx, batchSize) CandidateStrategy[]
    }

    class RandomGenerator {
        +seed int
        +generate(ctx, batchSize) CandidateStrategy[]
    }

    class DomainGuidedGenerator {
        +rules RuleSet
        +generate(ctx, batchSize) CandidateStrategy[]
    }

    class GeneticGenerator {
        <<optional extension>>
        +populationSize int
        +mutationRate Decimal
        +generate(ctx, batchSize) CandidateStrategy[]
    }

    class GeneratorRegistry {
        +register(descriptor)
        +resolve(id, version) CandidateGenerator
    }

    class SearchRunService {
        +start(command) SearchRunId
        +pause(runId)
        +resume(runId)
        +cancel(runId)
        +runNextBatch(runId)
    }

    class SearchSpace {
        +allowedStrategies StrategyRef[]
        +parameterBounds Bounds
        +combinationRules Rules
        +policyVersion String
    }

    class GenerationContext {
        +seed int
        +testedHashes Set
        +topKSummary Summary
        +remainingBudget Budget
    }

    class CandidateValidator {
        +validate(candidate, space) ValidationResult
        +canonicalHash(candidate) String
    }

    class StopPolicy {
        +maxCandidates int
        +maxDuration Duration
        +maxNonImproving int
        +maxFailureRate Decimal
        +shouldStop(snapshot) bool
    }

    class ExperimentService {
        +createImmutableExperiment(candidate, dataset, execution)
    }

    CandidateGenerator <|.. RandomGenerator
    CandidateGenerator <|.. DomainGuidedGenerator
    CandidateGenerator <|.. GeneticGenerator
    GeneratorRegistry o-- CandidateGenerator
    SearchRunService --> GeneratorRegistry
    SearchRunService --> SearchSpace
    SearchRunService --> GenerationContext
    SearchRunService --> CandidateValidator
    SearchRunService --> StopPolicy
    SearchRunService --> ExperimentService

    note for CandidateGenerator "Generator only proposes candidates.<br/>It does not backtest, rank or bypass quota."
    note for SearchRunService "Bounded loop checks stop, pause, cancel<br/>and quota before each batch."
    note for CandidateValidator "Reject unsupported, non-causal,<br/>out-of-bounds and duplicate candidates."
