flowchart TB
    Req["External request, URL or model proposal"] --> L1

    subgraph L1["L1 - Go public edge"]
        A1["request/correlation ID and structured log"]
        A2["exact CORS, security headers,<br/>body/rate limit"]
        A3["JWT, active principal, RBAC and quota"]
        A1 --> A2 --> A3
    end

    L1 --> L2
    subgraph L2["L2 - Signed Python domain boundary"]
        B1["signed principal/scopes, deadline,<br/>contract version and idempotency key"]
        B2["Python rechecks ownership and semantic input"]
        B3["Go cannot access Python base tables;<br/>Browser cannot access Python/AI directly"]
        B1 --> B2 --> B3
    end

    L2 --> L3
    subgraph L3["L3 - Safe source and model boundary"]
        C1["URL allowlist, HTTPS, DNS/IP/redirect/<br/>size/type/time guard"]
        C2["document/prompt is untrusted data,<br/>not instruction or authority"]
        C3["redact secrets and use structured,<br/>versioned model output"]
        C1 --> C2 --> C3
    end

    L3 --> L4
    subgraph L4["L4 - Agent tool enforcement"]
        D1["role + state + principal tool allowlist"]
        D2["schema, deadline, idempotency and budget gate"]
        D3["no generic shell, SQL, HTTP, filesystem,<br/>Docker, secret, fixture/policy/budget mutation"]
        D1 --> D2 --> D3
    end

    L4 --> L5
    subgraph L5["L5 - Strategy artifact and process isolation"]
        E1["StrategySpec semantic/causality check"]
        E2["deterministic compiler or custom-code policy check"]
        E3["non-root no-network/no-DB sandbox with resource limits"]
        E4["human review before immutable publish;<br/>hash/evidence/model provenance audit"]
        E1 --> E2 --> E3 --> E4
    end

    L5 --> Safe["Approved deterministic domain command<br/>or reviewed immutable StrategyVersion"]

    classDef edge fill:#e8f0f4,stroke:#315f7d,color:#2a251f;
    classDef boundary fill:#e9f1eb,stroke:#426b55,color:#2a251f;
    classDef input fill:#f5eddf,stroke:#8a6127,color:#2a251f;
    classDef tool fill:#f5e8e6,stroke:#8a4545,color:#2a251f;
    classDef runtime fill:#faf9f6,stroke:#6b6258,color:#2a251f;
    class A1,A2,A3 edge;
    class B1,B2,B3 boundary;
    class C1,C2,C3 input;
    class D1,D2,D3 tool;
    class E1,E2,E3,E4 runtime;
