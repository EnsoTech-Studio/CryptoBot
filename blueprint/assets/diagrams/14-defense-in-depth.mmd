flowchart TB
    REQ["External request / URL / model output"] --> L1

    subgraph L1["L1 — Go Edge"]
        A1["request/correlation ID + structured log"]
        A2["CORS/security headers/body limit/rate limit"]
        A3["JWT verify + active principal"]
        A1 --> A2 --> A3
    end

    L1 --> L2
    subgraph L2["L2 — Authorization & resource control"]
        B1["RBAC + ownership, deny by default"]
        B2["quota: concurrent runs/candidates/candles/AI tokens"]
        B3["idempotency key + bounded stop conditions"]
        B1 --> B2 --> B3
    end

    L2 --> L3
    subgraph L3["L3 — URL and AI input boundary"]
        C1["URL allowlist + HTTPS + DNS/IP/redirect/size guard"]
        C2["prompt injection treated as untrusted document text"]
        C3["PII/secrets filtering before remote model"]
        C1 --> C2 --> C3
    end

    L3 --> L4
    subgraph L4["L4 — StrategySpec/Model output guard"]
        D1["schema-constrained output; reject extra fields/code"]
        D2["supported DSL only: indicators/operators/bounded lookback"]
        D3["static cost/causality checks + bounded preview sandbox"]
        D4["human approval before immutable version publish"]
        D1 --> D2 --> D3 --> D4
    end

    L4 --> L5
    subgraph L5["L5 — Runtime/data/process isolation"]
        E1["Go market role vs Python domain role vs migration role"]
        E2["internal service auth + short deadline + circuit breaker"]
        E3["worker CPU/memory/time limit + no arbitrary network/DB"]
        E4["fingerprint/model/prompt/evidence audit + immutable provenance"]
        E1 --> E2 --> E3 --> E4
    end

    L5 --> SAFE["Approved deterministic StrategySpec / safe domain command"]

