classDiagram
    direction LR

    class ApprovedSource {
        +id: UUID
        +source_key: str
        +display_name: str
        +kind: rss | url
        +allowed_origin: str
        +url_template: str
        +is_active: bool
    }

    class CollectedItem {
        +source_id: UUID
        +canonical_url: str
        +url_hash: str
        +title: str
        +content: str
        +content_hash: str
        +published_at: datetime
        +related_coins: tuple~str~
        +extraction_version: str
        +tagging_version: str
    }

    class NewsProvider {
        <<protocol>>
        +collect(source, since) CollectedItem[]
    }

    class RssNewsProvider {
        -resolver: Resolver
        -fetcher: Fetcher
        +collect(source, since) CollectedItem[]
        -_parse(payload) CollectedItem[]
    }

    class HtmlNewsProvider {
        +collect(source, since) CollectedItem[]
        -_parse(source, page_url, payload, since) CollectedItem[]
    }

    class HtmlQualityGateFailed {
        <<exception>>
        +page_url: str
        +document_text: str
        +title_hint: str
        +published_at: datetime
        +reason: str
    }

    class SsrfBlocked {
        <<exception>>
        +reason: str
    }

    class NewsProviderError {
        <<exception>>
        +code: str
    }

    class NewsService {
        -store: Store
        -provider: NewsProvider | dict
        -analyzer: SentimentAnalyzer
        -extractor: NewsExtractionHTTPAdapter | None
        +collect_all(source_id) CollectionResult[]
        +collect_source(source, correlation_id) CollectionResult
        -_fallback_item(source, quality_failure, correlation_id) CollectedItem
        +analyze_pending(model, model_version, limit) SentimentBatchResult
    }

    class NewsExtractionHTTPAdapter {
        +extract(document_text, request_id) NewsExtraction
        +cache_key(document_text) str | None
    }

    class NewsExtraction {
        +title: str
        +body: str
        +model: str
        +model_version: str
    }

    class SentimentAnalyzer {
       <<protocol>>
       +analyze(text, request_id) SentimentResult
    }

    class SentimentResult {
        +label: str
        +score: float
        +model: str
        +model_version: str
        +analyzed_at: datetime
    }

    class SentimentHTTPAdapter {
        +analyze(text, request_id) SentimentResult
        +analyze_aggregate(text, request_id) SentimentResult
    }

    class Store {
        <<infrastructure.postgres>>
        +list_approved_sources(source_id) ApprovedSource[]
        +begin_news_collection(source_id) UUID | None
        +complete_news_collection(job_id, source, items, correlation_id)
        +persist_news_document(source, failure) UUID
        +find_news_extraction(document_id, cache_key) CollectedItem | None
        +persist_news_extraction(...)
        +pending_sentiment_items(model, model_version, limit) dict[]
        +persist_sentiment(news_item_id, result) bool
    }

    class NewsWorker {
        +collect_all() CollectionResult[]
        +analyze_pending() SentimentBatchResult
    }

    class Resolver {
        <<callable>>
        +resolve(host, port) str[]
    }

    class Fetcher {
        <<callable>>
        +get(url, host, addresses) response
    }

    NewsProvider <|.. RssNewsProvider
    NewsProvider <|.. HtmlNewsProvider
    SentimentAnalyzer <|.. SentimentHTTPAdapter
    RssNewsProvider --> Resolver
    RssNewsProvider --> Fetcher
    RssNewsProvider --> ApprovedSource
    HtmlNewsProvider --> ApprovedSource
    HtmlNewsProvider ..> HtmlQualityGateFailed : short/invalid article
    RssNewsProvider ..> NewsProviderError
    HtmlNewsProvider ..> NewsProviderError
    NewsService --> NewsProvider : provider map by kind
    NewsService --> Store : jobs/items/cache
    NewsService --> NewsExtractionHTTPAdapter : only after HTML quality failure
    NewsService --> SentimentAnalyzer : pending backfill
    NewsService --> CollectedItem
    NewsExtractionHTTPAdapter --> NewsExtraction
    SentimentHTTPAdapter ..> SentimentResult
    NewsWorker --> NewsService : periodic collection + sentiment loop
    Store --> ApprovedSource
    Store --> CollectedItem

    note for NewsProvider "Port is app/ports/news.py. Runtime bootstrap passes {rss: RssNewsProvider(), url: HtmlNewsProvider()}; no NewsSourceRegistry class."
    note for HtmlNewsProvider "Current HTML parser is _ArticleParser, not a ReadabilityExtractor class.<br/>Safe HTTPS/DNS/redirect/size/type checks are module functions."
    note for NewsService "Deterministic alias tagging happens inside provider normalization.<br/>Sentiment runs separately after collection; AI failure leaves item without result."
    note for NewsExtractionHTTPAdapter "Current fallback is direct typed HTTP inference on sanitized failure.document_text.<br/>NewsExtractionAgent + five-tool orchestration remains P1 target, not runtime code."
