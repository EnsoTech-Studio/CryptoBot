flowchart TB
    Controller["DiscoveryController<br/>owns state, archive, admission and stop"]
    Context["Frozen typed context<br/>catalog, archive summary, diversity gap,<br/>parent/failure evidence, correlations"]
    Mode{"Prompt mode"}
    New["new hypothesis"]
    Improve["improve failed strategy<br/>exactly one structural change"]
    Combine["combine<br/>flat complementary ensemble"]
    LLM["Typed LLM generator<br/>strict JSON CandidateSpec,<br/>hypothesis, operation, provenance"]
    Gate["Deterministic gate<br/>catalog, parameter, causality, risk,<br/>canonical hash, duplicate, quota, cost"]
    Archive["Persist archive outcome<br/>candidate or provider/schema failure"]
    Queue["Standard admission queue<br/>train then V1/V2/V3"]
    Deny["No shell/SQL/HTTP/filesystem;<br/>no Python/publish/backtest/result writes;<br/>no queue/quota/stop control"]

    Controller --> Context --> Mode
    Mode --> New --> LLM
    Mode --> Improve --> LLM
    Mode --> Combine --> LLM
    LLM --> Gate
    Gate -->|accepted| Queue --> Archive
    Gate -->|rejected/provider failure| Archive
    LLM -. forbidden .-> Deny

    classDef controller fill:#e9f1eb,stroke:#426b55,color:#2a251f,stroke-width:1.5px;
    classDef typed fill:#e8f0f4,stroke:#315f7d,color:#2a251f;
    classDef gate fill:#f5eddf,stroke:#8a6127,color:#2a251f;
    classDef deny fill:#f5e8e6,stroke:#8a4545,color:#2a251f;
    class Controller,Archive controller;
    class Context,New,Improve,Combine,LLM,Queue typed;
    class Mode,Gate gate;
    class Deny deny;
