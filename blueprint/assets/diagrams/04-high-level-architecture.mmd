flowchart TB
    U["Researcher / Author / Operator"]

    subgraph Client["CLIENT — render only"]
        Web["Next.js Dashboard<br/>charts · authoring · search · results · news"]
    end

    subgraph Go["GO EDGE & MARKET GATEWAY"]
        Edge["Public REST/WSS<br/>Auth · RBAC · quota · validation"]
        Market["MarketProviderRegistry<br/>Binance/OKX adapters · reconnect · backfill"]
        Normalize["Candle/BBO Normalizer<br/>checkpoint · de-dup · fan-out"]
        Ingress["Signed Internal Event Ingress"]
    end

    subgraph Python["PYTHON STRATEGY PLATFORM"]
        Strategy["Strategy API + shared StrategyRuntime<br/>StrategyRegistry · GeneratorRegistry<br/>AI authoring · realtime · search orchestration"]
        News["News/HTML Extract<br/>LLM tags · sentiment"]
        Evaluate["Evaluator · Ranking<br/>Provenance queries"]
    end

    subgraph Workers["PYTHON WORKER × N"]
        Worker["Lease-based Backtest Worker<br/>immutable Candle+BBO · LONG/SHORT<br/>TradeFacts + transactional outbox"]
    end

    DB[("PostgreSQL — source of truth<br/>market · immutable datasets · strategy versions<br/>jobs/results · news/tags · outbox")]
    Broker{{"Optional Broker / Redis Stream<br/>chỉ thêm khi benchmark chứng minh cần"}}

    subgraph External["EXTERNAL"]
        Exchange["Binance / OKX<br/>REST + WSS kline/BBO"]
        Sources["RSS / allowlisted Article HTML"]
        Models["LLM + Sentiment Model<br/>local hoặc remote adapter"]
    end

    U -->|HTTPS| Web
    Web <-->|"REST JSON + WebSocket"| Edge
    Exchange <-->|REST/WSS| Market --> Normalize
    Normalize -->|"market writer"| DB
    Normalize -->|"normalized market stream"| Strategy
    Normalize -->|"market delta"| Edge

    Edge -->|"signed internal commands"| Strategy
    Strategy -->|"persisted signal/progress events"| DB
    Strategy -->|"signed notification"| Ingress --> Edge

    Sources --> News
    News <--> Models
    Strategy <--> Models
    News --> DB
    Strategy -->|"atomic snapshot + job"| DB
    DB -->|"lease + immutable dataset"| Worker
    Worker -->|"facts + outbox atomically"| DB
    DB --> Evaluate --> DB
    Evaluate -->|"signed leaderboard event"| Ingress

    Strategy -. "JobQueue/EventStream port" .-> Broker
    DB -. "optional transport adapter" .-> Broker

    classDef external fill:#6b7280,stroke:#374151,color:#fff
    classDef client fill:#dbeafe,stroke:#2563eb,color:#111
    classDef go fill:#cffafe,stroke:#0891b2,color:#111
    classDef py fill:#fef3c7,stroke:#d97706,color:#111
    classDef worker fill:#fce7f3,stroke:#db2777,color:#111
    classDef db fill:#dcfce7,stroke:#16a34a,color:#111
    class Exchange,Sources,Models external
    class Web client
    class Edge,Market,Normalize,Ingress go
    class Strategy,News,Evaluate py
    class Worker worker
    class DB db
